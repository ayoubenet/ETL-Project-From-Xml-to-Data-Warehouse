            <ArticleTitle>[Benign mimickers of the prostate cancer. Diagnostic challenges].</ArticleTitle>
            <Pagination>
                <MedlinePgn>237-46</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.annpat.2013.06.005</ELocationID>
