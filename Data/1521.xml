            <ArticleTitle>PET/Computed Tomography in the Individualization of Treatment of Prostate Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>487-94</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpet.2015.05.004</ELocationID>
